# rls-guard configuration.
# Covering another schema must only ever require editing this file — never the engine.

tenant:
  columns: [tenant_id]          # column name(s) marking a table as tenant-scoped (org_id, workspace_id…)
  scope_functions: [current_tenant_id]
  # ^ functions whose presence in a policy/function counts as tenant scoping.
  #   Heuristic: they are presumed to derive the tenant from the CALLER's
  #   identity, never from caller-supplied input. If yours don't, fix them first.

privileged_roles: [service_role]  # roles that bypass tenant isolation by design (backend-only)

schemas:
  include: [public]
  exclude: [auth, storage]      # subtracted from include at scan time

# Replay vs live drift is chosen by the COMMAND you run (`check` vs `drift`),
# not by configuration — `drift` needs a DB credential, `check` never does.

# identity_anchors: ["auth.uid()", "auth.jwt()", "auth.role()"]
# ^ expressions anchoring a policy on the caller's identity (owner-based
#   policies count as scoped). Defaults shown; extend for non-Supabase stacks.

# definer:
#   identity_guards: []         # extra regexes recognized as caller-identity guards
#                               # in SECURITY DEFINER bodies (e.g. "\\bassert_caller\\b")

exceptions:
  # Every exception needs a reason. They are listed in every run's output and
  # excluded from the attestation — declared, motivated, visible, never silent.
  # Optional `expires: YYYY-MM-DD` re-enforces the invariant after that date.
  global_tables: []
  #  - name: fx_daily_rates
  #    reason: "Global reference data, no tenant rows"
  public_policies: []
  #  - name: public_read_directory
  #    table: directory
  #    reason: "Anonymous read of the public directory is intended"
  tenant_blind_writes: []
  definer_functions: []

postgres_version: "16"          # aligns the ephemeral replay with your production target
